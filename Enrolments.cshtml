@using System.Text.Json
@model List<JsonElement>

@{
    ViewData["Title"] = "Event Enrolments";
    var eventId = (int)ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Enrolments</h2>
        <a asp-action="Details" asp-route-id="@eventId" class="btn btn-outline-secondary">Back to Event</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No enrolments yet for this event.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th>Result</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var status = e.TryGetProperty("registrationStatus", out var st) ? st.GetString() : "—";
                    var badge = status == "Confirmed" ? "bg-success" :
                    status == "Pending" ? "bg-warning text-dark" : "bg-secondary";

                    string participantName = "—";
                    if (e.TryGetProperty("participant", out var p) && p.ValueKind == JsonValueKind.Object)
                    {
                        var fn = p.TryGetProperty("firstName", out var f) ? f.GetString() : "";
                        var ln = p.TryGetProperty("lastName", out var l) ? l.GetString() : "";
                        participantName = $"{fn} {ln}".Trim();
                    }

                    int enrollmentId = e.TryGetProperty("enrollmentId", out var eid) ? eid.GetInt32() : 0;

                    <tr>
                        <td>@participantName</td>
                        <td>@(e.TryGetProperty("category", out var cat) ? cat.GetString() : "—")</td>
                        <td><span class="badge @badge">@status</span></td>
                        <td>
                            @(e.TryGetProperty("registeredAt", out var ra) && ra.ValueKind != JsonValueKind.Null
                                                ? ra.GetDateTime().ToString("dd MMM yyyy") : "—")
                </td>
                <td>
                    @if (e.TryGetProperty("result", out var res) && res.ValueKind == JsonValueKind.Object)
                            {
                                var pos = res.TryGetProperty("finishPosition", out var fp) && fp.ValueKind != JsonValueKind.Null
                                ? fp.GetInt32().ToString() : "—";
                                var time = res.TryGetProperty("finishTime", out var ft) && ft.ValueKind != JsonValueKind.Null
                                ? ft.GetString() : "—";
                                <span>#@pos (@time)</span>
                            }
                            else
                            {
                                <span class="text-muted">No result</span>
                            }
                        </td>
                        <td>
                            @if (enrollmentId > 0)
                            {
                                <a asp-controller="Results" asp-action="Create"
                                   asp-route-enrollmentId="@enrollmentId"
                                   asp-route-eventId="@eventId"
                                   class="btn btn-sm btn-primary">
                                    Enter Result
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>