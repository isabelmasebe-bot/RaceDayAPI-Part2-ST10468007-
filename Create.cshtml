@model RaceDayMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Add Category";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="mb-4">Add Category to Event</h3>

                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="EventId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label"></label>
                            <input asp-for="CategoryName" class="form-control" placeholder="e.g. 10km Open" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinAge" class="form-label"></label>
                                <input asp-for="MinAge" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxAge" class="form-label"></label>
                                <input asp-for="MaxAge" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EntryFee" class="form-label"></label>
                            <input asp-for="EntryFee" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Add Category</button>
                            <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>