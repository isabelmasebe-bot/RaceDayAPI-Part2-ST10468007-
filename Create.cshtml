@{
    ViewData["Title"] = "Enter Result";
    var enrollmentId = (int)ViewBag.EnrollmentId;
    var eventId = (int)ViewBag.EventId;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="mb-4">Enter Result</h3>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Create" method="post">
                        <input type="hidden" name="enrollmentId" value="@enrollmentId" />
                        <input type="hidden" name="eventId" value="@eventId" />

                        <div class="mb-3">
                            <label class="form-label">Finish Time (HH:mm:ss)</label>
                            <input name="finishTime" class="form-control" placeholder="01:23:45" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Finish Position</label>
                            <input name="finishPosition" type="number" class="form-control" min="1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Performance Status</label>
                            <select name="performanceStatus" class="form-select">
                                <option value="Finished">Finished</option>
                                <option value="DNF">DNF</option>
                                <option value="DSQ">DSQ</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Result</button>
                            <a asp-controller="Events" asp-action="Enrolments" asp-route-id="@eventId"
                               class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>