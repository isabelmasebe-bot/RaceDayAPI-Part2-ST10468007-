@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Events</h2>
        <a asp-action="Create" class="btn btn-primary">+ Create Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">You have not created any events yet.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Location</td>
                        <td>
                            <span class="badge bg-@(item.Status == "Upcoming" ? "success" : "secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>