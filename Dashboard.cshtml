@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-controller="Events" asp-action="Create" class="btn btn-primary">
            + Create New Event
        </a>
    </div>

    <div class="alert alert-info">
        Welcome, <strong>@Context.Session.GetString("Email")</strong>!
        You are logged in as an <strong>Organiser</strong>.
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Events</h5>
                    <p class="display-6">—</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary btn-sm">Manage Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Categories</h5>
                    <p class="display-6">—</p>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary btn-sm">Manage Categories</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Results</h5>
                    <p class="display-6">—</p>
                    <a asp-controller="Results" asp-action="Index" class="btn btn-outline-primary btn-sm">Enter Results</a>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <h4>Quick Actions</h4>
    <div class="list-group">
        <a asp-controller="Events" asp-action="Create" class="list-group-item list-group-item-action">
            Create a new event
        </a>
        <a asp-controller="Events" asp-action="Index" class="list-group-item list-group-item-action">
            View / Edit my events
        </a>
        <a asp-controller="Categories" asp-action="Index" class="list-group-item list-group-item-action">
            Manage categories
        </a>
    </div>
</div>